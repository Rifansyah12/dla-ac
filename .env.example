# Opsional: ganti nomor WhatsApp Admin 2, dalam format internasional tanpa tanda +.
WHATSAPP_NUMBER=

# Mode JSON lama memakai ADMIN_PASSWORD; mode MySQL memakai akun individu.
# Keduanya memerlukan ADMIN_SESSION_SECRET. Jangan bagikan nilai ini.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# URL publik website, digunakan jika proxy mengubah header Host. Contoh: https://dlaac.example.com
APP_ORIGIN=

# Opsional: direktori data yang dapat ditulis. Default: ./data
AC_DATA_DIR=

# Penyimpanan katalog: json (default) atau mysql setelah migrasi dan impor selesai.
AC_STORAGE=json

# Diperlukan untuk migrasi/impor atau jika AC_STORAGE=mysql.
AC_DB_HOST=127.0.0.1
AC_DB_PORT=3306
AC_DB_NAME=
AC_DB_USER=
AC_DB_PASSWORD=
# Gunakan true bila server database menyediakan koneksi TLS dengan sertifikat tepercaya.
AC_DB_SSL=false

# SMTP email hosting untuk mengirim kode pemulihan kata sandi.
# Gunakan host dan port sesuai informasi cPanel. Jangan bagikan kredensial ini.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
